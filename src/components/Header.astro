---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Services', href: '/services' },
  { label: 'Areas We Cover', href: '/#areas-we-cover' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const hrefPath = href.split('#')[0].replace(/\/$/, '') || '/';
  return hrefPath === currentPath;
}
---
<header class="fixed top-0 left-0 right-0 z-50">
  <div class="bg-inverse-surface text-inverse-on-surface py-2 px-margin-mobile lg:px-margin shadow-sm text-xs font-label-tech">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-3 flex-wrap justify-center md:justify-start">
        <span class="inline-flex items-center gap-1.5 bg-tertiary text-on-tertiary px-2 py-0.5 rounded">
          <span class="w-2 h-2 rounded-full bg-tertiary-fixed animate-ping"></span>24/7 UK Emergency Recovery Dispatch Active
        </span>
        <span class="hidden sm:inline text-outline-variant">|</span>
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px] text-tertiary-fixed">speed</span>Average ETA 25 Mins
        </span>
        <span class="hidden md:inline text-outline-variant">|</span>
        <span class="hidden md:flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px] text-outline-variant">warehouse</span>Depot: 25 Kingsway, Birmingham, B4 7SL
        </span>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-inverse-on-surface/80">Immediate Support:</span>
        <a class="font-bold text-on-tertiary-container hover:text-tertiary-fixed transition-colors" href="tel:07700900123">07700 900123</a>
      </div>
    </div>
  </div>
  <div class="bg-surface-container-lowest/95 backdrop-blur-md shadow-[0_2px_12px_rgba(23,28,34,0.08)] border-b border-surface-container-high">
    <div class="h-20 max-w-7xl mx-auto px-margin-mobile lg:px-margin flex items-center justify-between gap-4">
      <a class="flex items-center gap-3 group" href="/">
        <div class="w-11 h-11 bg-primary rounded flex items-center justify-center text-on-primary shadow-sm group-hover:bg-primary-container transition-colors">
          <span class="material-symbols-outlined text-[24px]">emergency</span>
        </div>
        <div class="flex flex-col">
          <span class="font-headline-sm text-headline-sm uppercase tracking-tight text-on-surface leading-none font-bold">THE ROAD RESCUE GUYS</span>
          <span class="font-label-tech text-label-tech text-primary tracking-wider uppercase font-semibold">UK BREAKDOWN &amp; RECOVERY</span>
        </div>
      </a>
      <nav class="hidden lg:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            class={`font-label-md text-label-md py-2 transition-colors ${
              isActive(item.href)
                ? 'text-primary font-bold border-b-2 border-primary'
                : 'text-on-surface-variant hover:text-on-surface'
            }`}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-4">
        <a class="hidden sm:flex items-center gap-2 text-on-surface hover:text-primary transition-colors" href="tel:07700900123">
          <div class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[18px]">call</span>
          </div>
          <div class="flex flex-col text-left">
            <span class="font-label-tech text-label-tech text-on-surface-variant uppercase leading-none">24hr Dispatch</span>
            <span class="font-headline-sm text-label-lg font-bold">07700 900123</span>
          </div>
        </a>
        <a
          class="hidden md:inline-flex items-center justify-center px-space-lg py-3 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded shadow-sm hover:shadow transition-all"
          href="tel:07700900123"
        >
          <span class="material-symbols-outlined mr-2 text-[18px]">e911_emergency</span>Call Now
        </a>
        <button
          id="mobile-nav-toggle"
          aria-label="Toggle Navigation"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="lg:hidden w-11 h-11 flex items-center justify-center text-on-surface rounded hover:bg-surface-container"
          type="button"
        >
          <span class="material-symbols-outlined text-[26px]" id="mobile-nav-icon">menu</span>
        </button>
      </div>
    </div>
    <nav
      id="mobile-nav"
      class="hidden lg:hidden border-t border-surface-container-high bg-surface-container-lowest px-margin-mobile py-3"
    >
      <ul class="flex flex-col divide-y divide-surface-container-high">
        {navItems.map((item) => (
          <li>
            <a
              class={`block py-3.5 font-label-md text-label-md ${
                isActive(item.href) ? 'text-primary font-bold' : 'text-on-surface-variant'
              }`}
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const icon = document.getElementById('mobile-nav-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (icon) icon.textContent = isOpen ? 'menu' : 'close';
  });
</script>
