                <p class="font-headline-sm text-headline-sm text-on-surface truncate">Need Help Now?</p>
                <p class="font-label-tech text-label-tech text-on-surface-variant uppercase truncate">Available 24/7 UK Wide</p>
              </div>
            </div>
            <a class="px-4 py-2.5 bg-primary text-on-primary font-headline-sm text-[16px] rounded-lg hover:bg-secondary transition-colors whitespace-nowrap" href="tel:07700900123">
              07700 900123
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: QUICK CONTACT STRIP -->
  <section class="w-full bg-surface-container-low py-space-md">
    <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
        <a class="p-space-md bg-surface-container-lowest rounded-lg shadow-sm hover:shadow-md transition-all flex items-center gap-space-sm group" href="tel:07700900123">
          <div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-on-primary transition-colors">
            <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
          </div>
          <div class="min-w-0">
            <span class="font-label-tech text-[11px] text-on-surface-variant uppercase tracking-wider block">Direct Emergency Call</span>
            <span class="font-headline-sm text-[16px] text-on-surface block font-bold truncate">07700 900123</span>
          </div>
        </a>
        <a class="p-space-md bg-surface-container-lowest rounded-lg shadow-sm hover:shadow-md transition-all flex items-center gap-space-sm group" href="https://wa.me/447700900123" rel="noopener noreferrer" target="_blank">
          <div class="w-10 h-10 rounded-lg bg-tertiary-container/15 text-tertiary flex items-center justify-center group-hover:bg-tertiary group-hover:text-on-tertiary transition-colors">
            <span class="material-symbols-outlined text-[20px]">chat</span>
          </div>
          <div class="min-w-0">
            <span class="font-label-tech text-[11px] text-on-surface-variant uppercase tracking-wider block">WhatsApp Live Pin</span>
