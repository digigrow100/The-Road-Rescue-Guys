      </div>
      <div class="relative grid grid-cols-1 lg:grid-cols-3 gap-space-lg">
        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col gap-space-sm relative">
          <div class="flex items-center justify-between">
